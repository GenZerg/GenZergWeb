{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run",
			"type": "shell",
			"command": "bun run dev",
			"isBackground": true,
			"problemMatcher": [
				{
					"owner": "nuxt",
					"pattern": {
						"regexp": "^$"
					},
					"background": {
						"activeOnStart": true,
						"beginsPattern": ".",
						"endsPattern": "(Local:|Listening on|Nuxt|ready)"
					}
				}
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": false
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Publish",
			"type": "shell",
			"command": "bun run deploy",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			},
			"group": "none"
		}
	]
}
